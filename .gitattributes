# Auto detect text files and perform LF normalization
* text=auto
faiss_index/index.faiss filter=lfs diff=lfs merge=lfs -text
faiss_index/index.pkl filter=lfs diff=lfs merge=lfs -text
faiss_index/* filter=lfs diff=lfs merge=lfs -text
documents/*.pdf filter=lfs diff=lfs merge=lfs -text
# Sample demo PDF is small (~5 KB) — commit normalmente, sem LFS
sample_documents/*.pdf -filter -diff
